# ===========================================
# Smugflex AI Academy - Environment Variables
# ===========================================

# -------------------------------------------
# Backend Environment Variables
# -------------------------------------------

# Server
NODE_ENV=development
PORT=3001

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smugflex

# Redis
REDIS_URL=redis://localhost:6379

# Clerk Authentication
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key

# OpenAI
OPENAI_API_KEY=sk-your_openai_api_key

# Anthropic
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key

# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# Qdrant (Vector Database)
QDRANT_URL=http://localhost:6333

# Meilisearch
MEILI_URL=http://localhost:7700
MEILI_MASTER_KEY=masterKey

# -------------------------------------------
# Frontend Environment Variables
# -------------------------------------------

# API URL
VITE_API_URL=http://localhost:3001/api/v1

# Clerk (Frontend)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key

# -------------------------------------------
# Deployment Variables
# -------------------------------------------

# Railway (Backend)
# Set these in Railway dashboard:
# - DATABASE_URL (auto-generated by Railway PostgreSQL plugin)
# - REDIS_URL (auto-generated by Railway Redis plugin)
# - CLERK_SECRET_KEY
# - CLERK_PUBLISHABLE_KEY
# - OPENAI_API_KEY
# - ANTHROPIC_API_KEY
# - STRIPE_SECRET_KEY
# - STRIPE_WEBHOOK_SECRET

# Vercel (Frontend)
# Set these in Vercel dashboard:
# - VITE_API_URL (your Railway backend URL + /api/v1)
# - VITE_CLERK_PUBLISHABLE_KEY
